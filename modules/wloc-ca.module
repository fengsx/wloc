#!name=WLOC CA 持久化（本地参数）
#!desc=避免更新或切换完整配置后重复安装 CA；证书内容只保存在 Shadowrocket 本机参数中
#!author=fengsx
#!homepage=https://github.com/fengsx/wloc
#!category=Tools
#!arguments=启用证书:false, 证书密码:Shadowrocket, 证书内容:
#!arguments-desc=先从已安装证书的配置中复制 CA 内容，再通过“编辑参数”粘贴；填写后的内容只应保存在手机本地，禁止分享或提交到仓库

[MITM]
enable={{{启用证书}}}
ca-passphrase={{{证书密码}}}
ca-p12={{{证书内容}}}
